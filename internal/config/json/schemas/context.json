{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K9s context config schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "k9s": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "skin": {
          "type": "string"
        },
        "proxy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "string"
            },
            "lockFavorites": {
              "type": "boolean"
            },
            "favorites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "string"
            }
          }
        },
        "featureGates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeShell": {
              "type": "boolean"
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string" },
                "url": { "type": "string" },
                "tokenEnv": { "type": "string" }
              }
            },
            "alertmanager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string" },
                "url": { "type": "string" },
                "tokenEnv": { "type": "string" }
              }
            },
            "grafana": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string" },
                "url": { "type": "string" },
                "tokenEnv": { "type": "string" },
                "publicURL": { "type": "string" },
                "datasource": { "type": "string" },
                "dashboards": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pod": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    },
                    "workload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    },
                    "node": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    },
                    "namespace": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "hubble": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string"
            },
            "plaintext": {
              "type": "boolean"
            },
            "caFile": {
              "type": "string"
            },
            "certFile": {
              "type": "string"
            },
            "keyFile": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            },
            "clusterName": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "k9s"
  ]
}
