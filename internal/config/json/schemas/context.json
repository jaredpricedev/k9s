{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K9s context config schema",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "requestPathNames": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "requestPathMatch": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string" }
    },
    "requestPathService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingress": { "$ref": "#/definitions/requestPathNames" },
        "app": { "$ref": "#/definitions/requestPathNames" },
        "dns": { "$ref": "#/definitions/requestPathNames" },
        "network": { "$ref": "#/definitions/requestPathNames" },
        "dependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "profile"],
            "properties": {
              "service": { "type": "string" },
              "profile": { "type": "string" },
              "match": { "$ref": "#/definitions/requestPathMatch" }
            }
          }
        }
      }
    },
    "requestPathProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": { "type": "string" },
        "hop": { "type": "string", "enum": ["ingress", "app", "dependency", "dns", "network"] },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string" },
            "service": { "type": "string" },
            "ingress": { "type": "string" },
            "pod": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        "match": { "$ref": "#/definitions/requestPathMatch" },
        "signals": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "metric"],
            "properties": {
              "name": { "type": "string" },
              "title": { "type": "string" },
              "kind": { "type": "string", "enum": ["rate", "ratio", "quantile", "gauge"] },
              "metric": { "type": "string" },
              "match": { "$ref": "#/definitions/requestPathMatch" },
              "divisor": { "type": "string" },
              "divisorMatch": { "$ref": "#/definitions/requestPathMatch" },
              "quantile": { "type": "number", "minimum": 0, "maximum": 1 },
              "aggregate": { "type": "string", "enum": ["sum", "max", "min", "avg"] },
              "by": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
              "unit": { "type": "string", "enum": ["seconds", "ratio", "perSecond", "count", "bytes", "cores"] },
              "worse": { "type": "string", "enum": ["high", "low", "none"] }
            }
          }
        }
      }
    }
  },
  "properties": {
    "k9s": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "skin": {
          "type": "string"
        },
        "proxy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "string"
            },
            "lockFavorites": {
              "type": "boolean"
            },
            "favorites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "string"
            }
          }
        },
        "featureGates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeShell": {
              "type": "boolean"
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestPath": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "defaults": { "$ref": "#/definitions/requestPathService" },
                "services": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/definitions/requestPathService" }
                },
                "profiles": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/definitions/requestPathProfile" }
                }
              }
            },
            "queries": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["expr"],
                "properties": {
                  "title": { "type": "string" },
                  "expr": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "unit": { "enum": ["seconds", "ratio", "perSecond", "count", "bytes", "cores"] },
                  "legend": { "type": "string" }
                }
              }
            },
            "red": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": { "type": "string" },
                "codeLabel": { "type": "string" },
                "errorCodes": { "type": "string" },
                "durationBuckets": { "type": "string" },
                "namespaceLabel": { "type": "string" },
                "workloadLabel": { "type": "string" },
                "podLabel": { "type": "string" }
              }
            },
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string" },
                "url": { "type": "string" },
                "tokenEnv": { "type": "string" }
              }
            },
            "alertmanager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string" },
                "url": { "type": "string" },
                "tokenEnv": { "type": "string" }
              }
            },
            "grafana": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": { "type": "string" },
                "url": { "type": "string" },
                "tokenEnv": { "type": "string" },
                "publicURL": { "type": "string" },
                "datasource": { "type": "string" },
                "lokiDatasource": { "type": "string" },
                "dashboards": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pod": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    },
                    "workload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    },
                    "node": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    },
                    "namespace": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["uid"],
                      "properties": {
                        "uid": { "type": "string" },
                        "namespaceVar": { "type": "string" },
                        "podVar": { "type": "string" },
                        "workloadVar": { "type": "string" },
                        "nodeVar": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "hubble": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string"
            },
            "plaintext": {
              "type": "boolean"
            },
            "caFile": {
              "type": "string"
            },
            "certFile": {
              "type": "string"
            },
            "keyFile": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            },
            "clusterName": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "k9s"
  ]
}
